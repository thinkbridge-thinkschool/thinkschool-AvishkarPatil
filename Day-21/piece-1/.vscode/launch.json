{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug QuotesApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/QuotesApi/bin/Debug/net10.0/QuotesApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/QuotesApi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5075"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Attach to QuotesApi Process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
