{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=QuotesApiPerf;Trusted_Connection=true;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },

  "Database": {
    "Provider": "SqlServer",
    "LogSql":   true
  },

  "PerfDemo": {
    "SeedPerfData": true
  },

  "KeyVault": {
    "Uri": ""
  },

  "AppInsights": {
    "ConnectionString": ""
  },

  "Jwt": {
    "Key": "dev-only-key-replace-via-env-or-secrets-in-production-32b",
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClients",
    "AccessTokenExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 7
  },

  "EntraId": {
    "TenantId": "common",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "Audience": "api://00000000-0000-0000-0000-000000000000"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "QuotesApi.Application.Queries.Collections": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ServiceBus": {
    "ConnectionString": "",
    "TopicName": "quotes-topic",
    "AnalyticsSubscription": "analytics-subscription",
    "NotificationsSubscription": "notifications-subscription"
  },

  "AllowedHosts": "*"
}
