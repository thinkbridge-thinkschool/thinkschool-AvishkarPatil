{
  "ConnectionStrings": {
    "Default": "Data Source=quotes.db"
  },

  "Jwt": {
    "Key": "dev-only-key-replace-via-env-or-secrets-in-production-32b",
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClients",
    "AccessTokenExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 7
  },

  "EntraId": {
    "TenantId": "7e394fc8-4b86-4cfe-810e-43f86f8bec47",
    "ClientId": "608dbedc-b894-4e1f-ac64-762423165bef",
    "Audience": "api://608dbedc-b894-4e1f-ac64-762423165bef"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*"
}
